 757:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c **** 
 758:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c **** /** @defgroup PWR_Exported_Functions_Group3 Attributes Management Functions
 759:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   *  @brief    Attributes management functions
 760:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   *
 761:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c **** @verbatim
 762:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****  ===============================================================================
 763:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****                        ##### PWR Attributes Functions #####
 764:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****  ===============================================================================
 765:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****     [..]
 766:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       When the TrustZone security is activated by the TZEN option bit in the
 767:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       FLASH_OPTR register, some PWR register fields can be secured against
 768:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       non-secure access.
 769:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       The PWR TrustZone security allows the following features to be secured
 770:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       through the PWR_SECCFGR register :
 771:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c **** 
 772:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       (++) Low-power mode.
 773:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       (++) Wake-up (WKUP) pins.
 774:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       (++) Voltage detection and monitoring.
 775:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       (++) VBAT mode.
 776:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       (++) I/Os pull-up/pull-down configuration.
 777:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c **** 
 778:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       Other PWR configuration bits are secure when :
 779:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       (++) The system clock selection is secure in RCC: the voltage scaling
 780:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****            (VOS) configuration and the regulator booster (BOOSTEN) are secure.
 781:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       (++) A GPIO is configured as secure: its corresponding bit for pull-up /
 782:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****            pull-down configuration in Standby mode is secure.
 783:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       (++) The UCPD1 is secure in the GTZC: the PWR_UCPDR register is secure.
 784:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c **** 
 785:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       A non-secure access to a secure-protected register bit is denied :
 786:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       (++) The secured bits are not written (WI) with a non-secure write access.
 787:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       (++) The secured bits are read as 0 (RAZ) with a non-secure read access.
 788:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c **** 
 789:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****     [..]
 790:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       When the TrustZone security is disabled (TZEN = 0), PWR_SECCFGR is RAZ/WI
 791:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       and all other registers are non-secure.
 792:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c **** 
 793:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****     [..]
 794:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       By default, after a reset, all PWR registers can be read or written with
 795:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       both privileged and unprivileged accesses, except PWR_PRIVCFGR that can be
 796:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       written with privileged access only. PWR_PRIVCFGR can be read by secure
 797:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       and non secure, privileged and unprivileged accesses.
 798:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       The SPRIV bit in PWR_PRIVCFGR can be written with secure privileged access
 799:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       only. This bit configures the privileged access of all PWR secure
 800:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       functions (defined by PWR_SECCFGR, GTZC, RCC or GPIO).
 801:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       When the SPRIV bit is set in PWR_PRIVCFGR:
 802:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       (++) The PWR secure bits can be written only with privileged access,
 803:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       including PWR_SECCFGR.
 804:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       (++) The PWR secure bits can be read only with privileged access except
 805:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****            PWR_SECCFGR and PWR_PRIVCFGR that can be read by privileged or
 806:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****            unprivileged access.
 807:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       (++) An unprivileged access to a privileged PWR bit or register is
ARM GAS  /var/folders/j8/bx6g0dyx2gg_pdn7l_y1sb9c0000gn/T//ccWqwkLl.s 			page 36


 808:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****            discarded : the bits are read as zero and the write to these bits is
 809:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****            ignored (RAZ/WI).
 810:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       The NSPRIV bit of PWR_PRIVCFGR can be written with privileged access only,
 811:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       secure or non-secure. This bit configures the privileged access of all PWR
 812:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       securable functions that are configured as non-secure (defined by
 813:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       PWR_SECCFGR, GTZC, RCC or GPIO).
 814:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       When the NSPRIV bit is set in PWR_PRIVCFGR :
 815:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       (++) The PWR securable bits that are configured as non-secure, can be
 816:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****            written only with privileged access.
 817:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       (++) The PWR securable bits that are configured as non-secure, can be read
 818:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****            only with privileged access except PWR_PRIVCFGR that can be read by
 819:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****            privileged or unprivileged accesses.
 820:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       (++) The VOSRDY and BOOSTRDY bits in PWR_VOSR, PWR_SR, PWR_SVMSR, PWR_BDSR
 821:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****            and PWR_WUSR, can be read with privileged or unprivileged accesses.
 822:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       (++) An unprivileged access to a privileged PWR bit or register is
 823:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****            discarded : the bits are read as zero and the write to these bits is
 824:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****            ignored (RAZ/WI).
 825:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c **** 
 826:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c **** @endverbatim
 827:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   * @{
 828:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   */
 829:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c **** 
 830:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c **** /**
 831:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   * @brief  Configure the PWR item attributes.
 832:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   * @note   Available attributes are security and privilege protection.
 833:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   * @note   Security attribute can only be set only by secure access.
 834:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   * @note   Privilege attribute for secure items can be managed only by a secure
 835:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   *         privileged access.
 836:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   * @note   Privilege attribute for nsecure items can be managed  by a secure
 837:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   *         privileged access or by a nsecure privileged access.
 838:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   * @note As the privileged attributes concern either all secure or all non-secure
 839:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   *  PWR resources accesses and not each PWR individual items access attribute,
 840:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   *  the application must ensure that the privilege access attribute configurations
 841:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   *  are coherent amongst the security level set on PWR individual items so not to
 842:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   *  overwrite a previous more restricted access rule (consider either all secure
 843:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   *  and/or all non-secure PWR resources accesses by privileged-only transactions
 844:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   *  or privileged and unprivileged transactions).
 845:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   * @param  Item       : Specifies the item(s) to set attributes on.
 846:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   *                      This parameter can be a combination of @ref PWR_Items.
 847:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   * @param  Attributes : Specifies the available attribute(s).
 848:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   *                      This parameter can be one of @ref PWR_Attributes.
 849:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   * @retval None.
 850:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   */
 851:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c **** void HAL_PWR_ConfigAttributes(uint32_t Item, uint32_t Attributes)
 852:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c **** {
 785              		.loc 1 852 1 is_stmt 1 view -0
 786              		.cfi_startproc
 787              		@ args = 0, pretend = 0, frame = 0
 788              		@ frame_needed = 0, uses_anonymous_args = 0
 789              		@ link register save eliminated.
 853:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   /* Check the parameters */
 854:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   assert_param(IS_PWR_ITEMS_ATTRIBUTES(Item));
 790              		.loc 1 854 3 view .LVU135
