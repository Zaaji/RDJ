 791              		.loc 1 855 3 view .LVU136
 856:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c **** 
 857:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c **** #if defined (__ARM_FEATURE_CMSE) && (__ARM_FEATURE_CMSE == 3U)
ARM GAS  /var/folders/j8/bx6g0dyx2gg_pdn7l_y1sb9c0000gn/T//ccWqwkLl.s 			page 37


 858:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   /* Secure item management (TZEN = 1) */
 859:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   if ((Attributes & PWR_ITEM_ATTR_SEC_PRIV_MASK) == PWR_ITEM_ATTR_SEC_PRIV_MASK)
 860:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   {
 861:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****     /* Privilege item management */
 862:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****     if ((Attributes & PWR_SEC_PRIV) == PWR_SEC_PRIV)
 863:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****     {
 864:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       SET_BIT(PWR->SECCFGR, Item);
 865:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       SET_BIT(PWR->PRIVCFGR, PWR_PRIVCFGR_SPRIV);
 866:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****     }
 867:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****     else
 868:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****     {
 869:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       SET_BIT(PWR->SECCFGR, Item);
 870:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****       CLEAR_BIT(PWR->PRIVCFGR, PWR_PRIVCFGR_SPRIV);
 871:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****     }
 872:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   }
 873:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   /* NSecure item management */
 874:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal_pwr.c ****   else
