  93:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   *
  94:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c **** @verbatim
  95:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****  ===============================================================================
  96:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****               ##### Initialization and de-initialization functions #####
  97:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****  ===============================================================================
  98:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****     [..]  This section provides functions allowing to:
  99:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****       (+) Initializes the Flash interface the NVIC allocation and initial clock
 100:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****           configuration. It initializes the systick also when timeout is needed
 101:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****           and the backup domain when enabled.
 102:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****       (+) De-Initializes common part of the HAL.
 103:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****       (+) Configure The time base source to have 1ms time base with a dedicated
 104:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****           Tick interrupt priority.
 105:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****         (++) SysTick timer is used by default as source of time base, but user
 106:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****              can eventually implement his proper time base source (a general purpose
 107:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****              timer for example or other time source), keeping in mind that Time base
 108:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****              duration should be kept 1ms since PPP_TIMEOUT_VALUEs are defined and
 109:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****              handled in milliseconds basis.
 110:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****         (++) Time base configuration function (HAL_InitTick ()) is called automatically
 111:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****              at the beginning of the program after reset by HAL_Init() or at any time
 112:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****              when clock is configured, by HAL_RCC_ClockConfig().
 113:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****         (++) Source of time base is configured  to generate interrupts at regular
 114:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****              time intervals. Care must be taken if HAL_Delay() is called from a
 115:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****              peripheral ISR process, the Tick interrupt line must have higher priority
 116:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****             (numerically lower) than the peripheral interrupt. Otherwise the caller
 117:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****             ISR process will be blocked.
 118:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****        (++) functions affecting time base configurations are declared as __weak
 119:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****              to make  override possible  in case of other  implementations in user file.
 120:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c **** @endverbatim
 121:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   * @{
 122:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   */
 123:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c **** 
 124:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c **** /**
 125:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   * @brief  Configure the Flash prefetch, the time base source, NVIC and any required global low
 126:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   *         level hardware by calling the HAL_MspInit() callback function to be optionally defined
 127:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   *         in user file stm32u5xx_hal_msp.c.
 128:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   *
 129:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   * @note   HAL_Init() function is called at the beginning of program after reset and before
 130:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   *         the clock configuration.
 131:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   *
 132:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   * @note   In the default implementation the System Timer (SysTick) is used as source of time base
 133:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   *         The SysTick configuration is based on MSI clock, as MSI is the clock
 134:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   *         used after a system Reset and the NVIC configuration is set to Priority group 4.
 135:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   *         Once done, time base tick starts incrementing: the tick variable counter is incremented
 136:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   *         each 1ms in the SysTick_Handler() interrupt handler.
 137:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   *
 138:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   * @retval HAL status
 139:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   */
 140:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c **** HAL_StatusTypeDef HAL_Init(void)
 141:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c **** {
 142:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   /* Configure Flash prefetch */
 143:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c **** #if (PREFETCH_ENABLE != 0U)
ARM GAS  /var/folders/j8/bx6g0dyx2gg_pdn7l_y1sb9c0000gn/T//ccllYtJQ.s 			page 4


 144:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   __HAL_FLASH_PREFETCH_BUFFER_ENABLE();
 145:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c **** #endif /* PREFETCH_ENABLE */
 146:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c **** 
 147:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   /* Set Interrupt Group Priority */
 148:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   HAL_NVIC_SetPriorityGrouping(NVIC_PRIORITYGROUP_4);
 149:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c **** 
 150:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   /* Update the SystemCoreClock global variable */
 151:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   SystemCoreClock = HAL_RCC_GetSysClockFreq() >> AHBPrescTable[(RCC->CFGR2 & RCC_CFGR2_HPRE) >> RCC
 152:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c **** 
 153:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   /* Select HCLK as SysTick clock source */
 154:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   HAL_SYSTICK_CLKSourceConfig(SYSTICK_CLKSOURCE_HCLK);
 155:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c **** 
 156:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   /* Use systick as time base source and configure 1ms tick (default clock after Reset is HSI) */
 157:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   if (HAL_InitTick(TICK_INT_PRIORITY) != HAL_OK)
 158:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   {
 159:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****     return HAL_ERROR;
 160:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   }
 161:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c **** 
 162:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   /* Init the low level hardware */
 163:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   HAL_MspInit();
 164:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c **** 
 165:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   /* Return function status */
 166:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c ****   return HAL_OK;
 167:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c **** }
 168:Drivers/STM32U5xx_HAL_Driver/Src/stm32u5xx_hal.c **** 
